# Add this as a protected server-side secret locally and in Vercel/Sites.
# Never prefix this variable with NEXT_PUBLIC_ and never commit a real key.
GEMINI_API_KEY=

# Optional. The safe default is used when this is blank.
GEMINI_MODEL=gemini-2.5-flash

# Airtable stays on the server. Use a personal access token with record read/write access.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# Optional. If blank, the app creates a stable six-digit code from the server secrets.
ALEX_ACCESS_CODE=

# Optional canonical URL for social-share previews.
PUBLIC_SITE_URL=http://localhost:3001
